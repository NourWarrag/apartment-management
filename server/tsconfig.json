{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@hotel/shared": ["../shared/index.ts"]
    }
  },
  "include": ["src", "tests", "prisma"],
  "exclude": ["node_modules", "dist"]
}
